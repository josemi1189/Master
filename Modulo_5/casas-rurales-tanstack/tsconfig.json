{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "declaration": false,
    "noImplicitAny": false,
    "sourceMap": true,
    "jsx": "react-jsx",
    "noLib": false,
    "allowJs": false,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strictNullChecks": true,
    "types": ["node", "vite/client"],
    "paths": {
      "#*": ["./src/*"],
      "@*": ["./src/*"]
    }
  },
  "include": ["src", "src/**/*.scss"]
}
